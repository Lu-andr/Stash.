{
  "expo": {
    "name": "PeraGo",
    "slug": "perago",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/perago-icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/perago-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#071426"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.stash",
      "infoPlist": {
        "RCTAsyncStorageExcludeFromBackup": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/perago-icon.png",
        "backgroundColor": "#071426"
      },
      "package": "app.stash",
      "versionCode": 4,
      "allowBackup": false,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.c2dm.permission.RECEIVE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/perago-icon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071426",
          "image": "./assets/perago-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#071426",
            "image": "./assets/perago-icon.png"
          }
        }
      ],
      "./plugins/withPeraGoIcon.cjs"
    ],
    "updates": {
      "enabled": false
    }
  }
}
